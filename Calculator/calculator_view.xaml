<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator.MainPage"
             >

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Style for Circular Buttons -->
            <Style x:Key="CircleButton" TargetType="Button">
                <Setter Property="WidthRequest" Value="50"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="CornerRadius" Value="25"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="BackgroundColor" Value="#FF6D716D"/>
                <Setter Property="TextColor" Value="White"/>
            </Style>

            <!-- Style for Operation buttons -->
            <Style x:Key="OperationButton" TargetType="Button">
                <Setter Property="WidthRequest" Value="50"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="CornerRadius" Value="25"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="BackgroundColor" Value="#FFE88F0B"/>
                <Setter Property="TextColor" Value="White"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout
            Padding="30,0"
            Spacing="10">


            <Label
                x:Name="DisplayLabelOperation"
                Text=""
                FontSize="30"
                HorizontalOptions="End"
                VerticalOptions="End"
                MinimumHeightRequest="50"  
                SemanticProperties.Description="Calculator display" />

            <Label
                x:Name="DisplayLabel"
                Text="0"
                FontSize="30"
                HorizontalOptions="End"
                VerticalOptions="End"
                MinimumHeightRequest="50"  
                SemanticProperties.Description="Calculator display" />

            <Grid 
                RowDefinitions="*,*,*,*,*"
                ColumnDefinitions="*,*,*,*"
                RowSpacing="20"
                ColumnSpacing="50">

                <!-- Additional operations -->
                <Button Text="AC" Grid.Row="0" Grid.Column="0" 
                    Clicked="OnClearClicked" 
                    Style= "{StaticResource CircleButton}"/>
                <Button Text="*/-" Grid.Row="0" Grid.Column="1" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="%" Grid.Row="0" Grid.Column="2" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="/" Grid.Row="0" Grid.Column="3" Clicked="OnButtonClicked" Style= "{StaticResource OperationButton}"/>

                
                <!-- First Row (7, 8, 9, /) -->
                <Button Text="7" Grid.Row="1" Grid.Column="0" Clicked="OnButtonClicked" Style = "{StaticResource CircleButton}"/>
                <Button Text="8" Grid.Row="1" Grid.Column="1" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="9" Grid.Row="1" Grid.Column="2" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="X" Grid.Row="1" Grid.Column="3" Clicked="OnButtonClicked" Style= "{StaticResource OperationButton}"/>
                
                <!-- Second Row (4, 5, 6, *) -->
                <Button Text="4" Grid.Row="2" Grid.Column="0" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="5" Grid.Row="2" Grid.Column="1" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="6" Grid.Row="2" Grid.Column="2" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="-" Grid.Row="2" Grid.Column="3" Clicked="OnButtonClicked" Style= "{StaticResource OperationButton}"/>
                
                <!-- Third Row (1, 2, 3, -) -->
                <Button Text="1" Grid.Row="3" Grid.Column="0" 
                    Clicked="OnButtonClicked" 
                    Style= "{StaticResource CircleButton}"/>

                <Button Text="2" Grid.Row="3" Grid.Column="1" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="3" Grid.Row="3" Grid.Column="2" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="+" Grid.Row="3" Grid.Column="3" Clicked="OnButtonClicked" Style= "{StaticResource OperationButton}"/>
                
                <!-- Fourth Row (0, C, =, +) -->
                <Button Text="C" Grid.Row="4" Grid.Column="0" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="0" Grid.Row="4" Grid.Column="1" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="," Grid.Row="4" Grid.Column="2" Clicked="OnButtonClicked" Style= "{StaticResource CircleButton}"/>
                <Button Text="=" Grid.Row="4" Grid.Column="3" Clicked="OnEqualClicked" Style= "{StaticResource OperationButton}"/>

            </Grid>
        </VerticalStackLayout>


</ContentPage>
